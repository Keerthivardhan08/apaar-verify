# ============================================================
# APAAR Verify — Environment Configuration
# Copy this file to .env and fill in values before running.
# NEVER commit the .env file to version control.
# ============================================================

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://apaar:apaar123@localhost:5432/apaardb

# ─── Security ────────────────────────────────────────────────
# Generate a strong random key for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production-never-use-this-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Application ─────────────────────────────────────────────
DEMO_MODE=true
APP_NAME=APAAR Verify
APP_VERSION=0.1.0

# ─── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Upload Limits ───────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
MAX_ROWS_PER_BATCH=5000

# ─── Credential Settings ─────────────────────────────────────
CREDENTIAL_ISSUER=apaar-verify-demo
CREDENTIAL_EXPIRE_HOURS=24

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Feature Flags ───────────────────────────────────────────
ENABLE_GRAPH_VIEW=true
ENABLE_STUDENT_PORTAL=false

# ─── Demo Credentials (REMOVE IN PRODUCTION) ─────────────────
# These are seeded in the database by the seed script.
# DEMO_ADMIN_EMAIL=admin@aicte.gov.in
# DEMO_ADMIN_PASSWORD=Demo@1234
# DEMO_INSTITUTION_EMAIL=operator@iit-demo.edu
# DEMO_INSTITUTION_PASSWORD=Demo@1234
