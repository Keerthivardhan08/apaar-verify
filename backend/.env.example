# APAAR Verify Backend Environment Configuration

# Database: SQLite for local demo/development (default), or PostgreSQL for production
DATABASE_URL=sqlite:///./apaar.db
# DATABASE_URL=postgresql://apaar:apaar123@localhost:5432/apaardb

# Cryptography & Security
SECRET_KEY=dev-secret-key-change-in-production-never-use-this-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Demo Mode & Verifiable Credentials
DEMO_MODE=true
CREDENTIAL_ISSUER_ID=apaar-verify-demo
CREDENTIAL_EXPIRE_DAYS=365

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost:8000"]
